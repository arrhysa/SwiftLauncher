{
  "name": "swiftlauncher",
  "productName": "SwiftLauncher",
  "version": "1.1.0",
  "description": "SwiftLauncher — быстрый лаунчер Minecraft",
  "author": "SwiftLauncher",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run compile:electron -- --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "compile:renderer": "tsc --noEmit -p tsconfig.json && vite build",
    "compile:electron": "node scripts/build-electron.mjs",
    "compile": "npm run compile:renderer && npm run compile:electron",
    "icons": "node scripts/make-icons.mjs",
    "build": "npm run compile && electron-builder --win nsis portable --publish never",
    "release": "npm run compile && electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xmcl/core": "2.13.0",
    "@xmcl/installer": "5.4.0",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.24.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "minecraft-launcher-core": "^3.18.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arrhysa/SwiftLauncher.git"
  },
  "homepage": "https://github.com/arrhysa/SwiftLauncher"
}